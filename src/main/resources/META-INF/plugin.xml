<!-- Plugin Configuration File -->
<idea-plugin>
    <id>su.dng.demo1</id>
    <name>Demo1 — Say Hello</name>
    <vendor url="https://github.com/GDennik">GDennik</vendor>

    <description><![CDATA[
        Простой плагин для IntelliJ IDEA, демонстрирующий создание пользовательского действия в контекстном меню редактора.
        При вызове показывает приветственное диалоговое окно.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <actions>
        <action id="su.dng.demo1.HelloAction"
                class="su.dng.demo1.HelloAction"
                text="Say Hello"
                description="Показывает приветственное сообщение">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
